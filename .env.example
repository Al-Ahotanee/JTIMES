# Neon PostgreSQL connection string (get this from the Neon dashboard).
# Include ?sslmode=require — Neon requires TLS.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/jigawa_times?sslmode=require

# Secret used to sign login sessions (JWT). Generate a long random string,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

NODE_ENV=development
PORT=3000

# Cloudinary free-tier account (cloudinary.com) — used for all article
# images/video so nothing is stored on Render's ephemeral disk or in
# Postgres. Find these on your Cloudinary Dashboard home page.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# AI NEWSROOM CONFIGURATION
# =============================================================================

# AI provider for story analysis and article writing.
# Currently only "gemini" is supported.
AI_PROVIDER=gemini

# Google Gemini API key (https://ai.google.dev/).
# Recommended models: gemini-2.0-flash or gemini-2.5-flash (fast, modern, cost-effective).
# For higher quality reasoning: gemini-2.5-pro.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Image generation provider (leave blank to skip AI image generation).
# When blank, the newsroom will use source images from RSS feeds where available.
IMAGE_PROVIDER=
IMAGE_API_KEY=

# Editorial mode:
#   manual    — AI discovers and prepares articles; human publishes
#   semi_auto — low-risk articles are submitted for review automatically
#   auto      — low-risk articles are published automatically (high-risk still requires review)
NEWSROOM_MODE=manual

# Set to false ONLY when you are ready for the newsroom to actually publish.
# Default is true — articles are prepared but never submitted to the API.
NEWSROOM_DRY_RUN=true

# How often the newsroom scanner runs automatically (0 = manual only).
# On Render free plan, consider using manual runs only (npm run newsroom).
NEWSROOM_INTERVAL_MINUTES=0

# Max concurrent AI requests (keep low to control costs).
NEWSROOM_CONCURRENCY=2

# Base URL of the Jigawa Times API (same-server calls when running inside server.js).
EXISTING_API_URL=http://localhost:3000

# JWT token for the newsroom author account.
# Generate: log in as admin, copy the value of the jt_token cookie.
# The newsroom uses this to authenticate against /api/articles.
NEWSROOM_API_TOKEN=

# Email of the author account used as the AI article byline.
NEWSROOM_AUTHOR_EMAIL=admin@jigawatimes.ng
