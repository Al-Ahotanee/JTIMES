// Jigawa Times — Prisma schema
//
// IMPORTANT: In production this schema is NOT applied with
// `prisma migrate deploy` or `prisma db push`. The schema is created
// manually by running /migrations.sql in the Neon SQL Editor (Render's
// free Web Service plan has no post-deploy shell access to run migration
// commands). This file exists only so Prisma Client can be generated
// (`prisma generate`, a pure code-gen step with no DB connection) and
// used as the query layer against the tables migrations.sql already
// created. Keep this file's models in sync with migrations.sql by hand.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  REPORTER
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(REPORTER)
  bio           String?
  avatar        String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  articles          Article[]
  editorialActions  EditorialAction[]
  editorialComments EditorialComment[]
  liveUpdates       LiveUpdate[]
  revisions         ArticleRevision[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles Article[]
}

model Article {
  id                 Int           @id @default(autoincrement())
  title              String
  slug               String        @unique
  excerpt            String?
  content            String
  featuredImage      String?
  imageCaption       String?
  status             ArticleStatus @default(DRAFT)
  isBreaking         Boolean       @default(false)
  isFeatured         Boolean       @default(false)
  isLive             Boolean       @default(false) @map("is_live")
  scheduledPublishAt DateTime?     @map("scheduled_publish_at")
  authorId           Int
  categoryId         Int
  views              Int           @default(0)
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  author            User                 @relation(fields: [authorId], references: [id])
  category          Category             @relation(fields: [categoryId], references: [id])
  tags              ArticleTag[]
  comments          Comment[]
  editorialActions  EditorialAction[]
  newsroomItems     NewsroomItem[]
  revisions         ArticleRevision[]
  editorialComments EditorialComment[]
  liveUpdates       LiveUpdate[]
  readingStats      ArticleReadingStat[]

  @@index([status])
  @@index([publishedAt])
  @@index([scheduledPublishAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([views])
  @@index([isLive])
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  articles ArticleTag[]
}

model ArticleTag {
  articleId Int
  tagId     Int

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  articleId Int
  name      String
  email     String
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model EditorialAction {
  id        Int      @id @default(autoincrement())
  articleId Int
  userId    Int
  action    String
  note      String?
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([articleId])
}

// ---------------------------------------------------------------------
// Enterprise Models: Native Ads, Revisions, Notes, Live-Blog, Heatmap
// ---------------------------------------------------------------------

model Ad {
  id          Int       @id @default(autoincrement())
  title       String
  sponsorName String    @map("sponsor_name")
  placement   String    // HEADER_LEADERBOARD, IN_ARTICLE, SIDEBAR_STICKY
  imageUrl    String    @map("image_url")
  targetUrl   String    @map("target_url")
  active      Boolean   @default(true)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([placement, active])
  @@map("ads")
}

model ArticleRevision {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  userId    Int      @map("user_id")
  title     String
  excerpt   String?
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_revisions")
}

model EditorialComment {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  userId    Int      @map("user_id")
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("editorial_comments")
}

model LiveUpdate {
  id          Int      @id @default(autoincrement())
  articleId   Int      @map("article_id")
  authorId    Int      @map("author_id")
  title       String?
  content     String
  isPinned    Boolean  @default(false) @map("is_pinned")
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([articleId, publishedAt])
  @@map("live_updates")
}

model ArticleReadingStat {
  id        Int      @id @default(autoincrement())
  articleId Int      @map("article_id")
  milestone Int      // 25, 50, 75, 100
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, milestone])
  @@map("article_reading_stats")
}


model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// AI Newsroom tracking table.
// Stores discovered source stories and their pipeline processing status.
// article_id links to the Article created from this story (if any).
model NewsroomItem {
  id             Int       @id @default(autoincrement())
  sourceUrl      String    @unique @map("source_url")
  sourceName     String    @map("source_name")
  sourceTitle    String?   @map("source_title")
  contentHash    String?   @map("content_hash")
  status         String    @default("DISCOVERED")
  category       String?
  reviewRequired Boolean   @default(false) @map("review_required")
  articleId      Int?      @map("article_id")
  verification   Json?
  rawData        Json?     @map("raw_data")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contentHash])
  @@map("newsroom_items")
}
